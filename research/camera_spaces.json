  "reverse_engineered": {
    "source": "psychopath.io 'Blackmagic Design's Color Spaces' (2022-04-23), reverse-engineered from DaVinci Resolve output",
    "method": "encoded->linear LUTs extracted from Resolve via a 2^17-step gradient OpenEXR, then analytic constants fitted; tool open sourced",
    "accuracy": "avg relative error ~7e-7, max < 1e-4 (Pocket Film series worse)",
    "caveat": "derived from Resolve's implementation, not from BMD camera silicon. White points land slightly off D65 (0.3135, 0.3305), which is reverse-engineering noise, not a real white point.",
    "validation": "the Gen5 constants below reproduce colour-science's published Blackmagic Film Generation 5 to ~1e-7 relative, which is an independent cross-check of the whole method."
  },
